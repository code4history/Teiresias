{
  "name": "@c4h/teiresias",
  "version": "0.0.1",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "README.ja.md"
  ],
  "description": "CRS and world-file estimator for Maplat.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code4history/Teiresias.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/code4history/Teiresias/issues"
  },
  "homepage": "https://code4history.github.io/Teiresias/",
  "engines": {
    "pnpm": ">=10",
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:types": "tsc --ignoreConfig --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck tests/api-smoke.test.ts",
    "test:types:atlas": "tsc --ignoreConfig --noEmit --strict --target ES2022 --module ESNext --moduleResolution Bundler --skipLibCheck tests/api-smoke.test.ts tests/atlas-adapter-contract.test.ts",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "dev": "vite --host",
    "build:demo": "vite build",
    "preview": "vite preview",
    "verify:demo": "GITHUB_PAGES=true pnpm run build:demo && node scripts/verify-demo-pages-build.mjs",
    "verify:demo-bundle": "node scripts/verify-demo-browser-bundle.mjs",
    "smoke:consumer": "node scripts/consumer-smoke.mjs",
    "prepublishOnly": "pnpm run test && pnpm run typecheck && pnpm run test:types && pnpm run test:types:atlas && pnpm run build && pnpm run verify:demo && pnpm run verify:demo-bundle"
  },
  "dependencies": {
    "@c4h/daedalus": "^1.0.0"
  },
  "devDependencies": {
    "@c4h/atlas": "^1.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "jsdom": "^30.0.1",
    "proj-wasm": "0.1.0-alpha8",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vitest": "^5.0.4"
  }
}
