{
  "name": "@c4h/teiresias",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "description": "CRS and world-file estimator for Maplat V3.1.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code4history/Teiresias.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/code4history/Teiresias/issues"
  },
  "homepage": "https://code4history.github.io/Teiresias/",
  "engines": {
    "pnpm": ">=10",
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:types": "tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck tests/api-smoke.test.ts",
    "test:types:atlas": "tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution Bundler --skipLibCheck tests/api-smoke.test.ts",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "dev": "vite --host",
    "build:demo": "vite build",
    "preview": "vite preview",
    "verify:demo": "GITHUB_PAGES=true pnpm run build:demo && node scripts/verify-demo-pages-build.mjs",
    "verify:demo-bundle": "node scripts/verify-demo-browser-bundle.mjs"
  },
  "dependencies": {
    "@c4h/daedalus": "link:../Daedalus"
  },
  "devDependencies": {
    "@c4h/atlas": "link:../Atlas",
    "@types/node": "^25.5.2",
    "@vitest/coverage-v8": "^3.2.6",
    "jsdom": "^30.0.0",
    "proj-wasm": "0.1.0-alpha8",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.6"
  }
}
